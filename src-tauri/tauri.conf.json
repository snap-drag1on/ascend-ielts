{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ASCEND",
  "version": "0.1.0",
  "identifier": "com.snapdrag1on.ascend",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ASCEND",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "acceptFirstMouse": true,
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Premium macOS productivity + IELTS tracker",
    "longDescription": "ASCEND is a 100% offline, native-feeling macOS productivity operating system for IELTS preparation. Track sessions, mocks, mistakes, and progress across Listening, Reading, Writing, and Speaking.",
    "copyright": "Copyright © 2025 snap-drag1on",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "frameworks": [],
      "exceptionDomain": "",
      "dmg": {
        "background": null,
        "windowPosition": { "x": 400, "y": 200 },
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 }
      }
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:ascend.db"]
    }
  }
}
